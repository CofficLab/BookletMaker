    { "path": "Config/Base.xcconfig", "index": true },
    { "path": "Config/App-Shared.xcconfig", "index": true },
    { "path": "<PRODUCTS>/BookletMaker.app", "id": "BM0000000000000000000002", "type": "wrapper.application", "index": false },
